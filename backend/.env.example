# Database Configuration
# Default: Local PostgreSQL. Fallback: SQLite
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/career_twin
# Fallback local sqlite for development when PostgreSQL is not running:
SQLITE_FALLBACK_URL=sqlite:///./career_twin.db

# App Settings
APP_NAME="AI Digital Career Twin"
APP_ENV=development
API_V1_PREFIX=/api
DEBUG=True

# JWT Secret (for Phase 3)
SECRET_KEY=change_this_to_a_secure_random_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
